{
   "format_version_major" : 1,
   "format_version_minor" : 0,
   "format_version_patch" : 0,
   "name"                 : "auto_interface_0dim",
   "section"              : 2010,
   "comment"              : "Automotive user interface 0dimensional parameters",
   "parameters"           : [
      {
         "id"      : 0,
         "name"    : "tx_antenna_idx",
         "type"    : "u8",
         "comment" : "Index of Transmit Antenna",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 2,
         "default" : 0
      },
      {
         "id"      : 1,
         "name"    : "center_frequency_idx",
         "type"    : "u8",
         "comment" : "Index of center frequency",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 2,
         "default" : 1
      },
      {
         "id"      : 2,
         "name"    : "frequency_sweep_idx",
         "type"    : "u8",
         "comment" : "Index of sweep (0=226MHz)",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 0,
         "default" : 0
      },
      {
         "id"      : 10,
         "name"    : "prf_selector_manual",
         "type"    : "u8",
         "comment" : "0 = PRF switching active, 1 = PRF index given in prf_selector_index is used",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 1,
         "default" : 0
      },
      {
         "id"      : 11,
         "name"    : "prf_set_selector",
         "type"    : "u8",
         "comment" : "Select PRF set index (only one set supported)",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 0,
         "default" : 0
      },
      {
         "id"      : 12,
         "name"    : "prf_manual_value_idx",
         "type"    : "u8",
         "comment" : "In manual PRF mode only: use nth element of selected set",
         "access"  : "rw",
         "save"    : true,
         "min"     : 0,
         "max"     : 2,
         "default" : 0
      },
      {
         "id"      : 13,
         "name"    : "detection_sensitivity",
         "type"    : "u8",
         "access"  : "rw",
         "save"    : true,
         "comment" : "Detection sensitivity: 0=low, 1=normal, 2=high",
         "min"     : 0,
         "max"     : 2,
         "default" : 1
      },
      {
         "id"      : 20,
         "name"    : "tv_min_speed_sweep_idx_0",
         "type"    : "f32",
         "access"  : "rw",
         "save"    : true,
         "comment" : "Target Validation: minimum speed of target at first sweep",
         "min"     : -150.0,
         "max"     : 150.0,
         "default" : -150.0
      },
      {
         "id"      : 30,
         "name"    : "tv_max_speed_sweep_idx_0",
         "type"    : "f32",
         "access"  : "rw",
         "save"    : true,
         "comment" : "Target Validation: maximum speed of target at first sweep",
         "min"     : -150.0,
         "max"     : 150.0,
         "default" : 150.0
      },
      {
         "id"      : 103,
         "name"    : "azimuthal_angle_org",
         "type"    : "f32",
         "access"  : "rw",
         "save"    : true,
         "comment" : "[rad] Original Orientation of the sensor in Cartesian coordinate system in X-Y plane configured during setup,  valid interval (-pi, pi)",
         "min"     : -3.14159265,
         "max"     : 3.14159265,
         "default" : 0
      },
      {
         "id"      : 104,
         "name"    : "elevation_angle_org",
         "type"    : "f32",
         "access"  : "rw",
         "save"    : true,
         "comment" : "[rad] Original Orientation of the sensor in Cartesian coordinate system in X-Z plane configured during setup, valid interval [-pi/2, pi/2]",
         "min"     : -1.57079642,
         "max"     : 1.57079642,
         "default" : 0
      },
      {
         "id"     : 200,
         "name"   : "output_control_target_list_can",
         "type"   : "u8",
         "comment": "send raw targets via CAN, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 201,
         "name"   : "output_control_object_list_can",
         "type"   : "u8",
         "comment": "send objects via CAN, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 202,
         "name"   : "output_control_target_list_eth",
         "type"   : "u8",
         "comment": "send raw targets via Ethernet, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 203,
         "name"   : "output_control_object_list_eth",
         "type"   : "u8",
         "comment": "send objects via Ethernet, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 204,
         "name"   : "output_control_crash_barrier_can",
         "type"   : "u8",
         "comment": "send crash barrier data via CAN, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 205,
         "name"   : "output_control_dynamics_eth",
         "type"   : "u8",
         "comment": "send dynamics data via Ethernet, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 209,
         "name"   : "output_control_diagnostic_eth",
         "type"   : "u8",
         "comment": "send diagnostic port via Ethernet, 0 = disabled, 1 = enabled",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 1,
         "default": 1
      },
      {
         "id"     : 231,
         "name"   : "ip_source_address",
         "type"   : "u32",
         "access" : "rw",
         "save"   : true,
         "comment": "IP source address (32bit)",
         "default": 3232238347
      },
      {
         "id"     : 233,
         "name"   : "subnet_mask",
         "type"   : "u32",
         "access" : "rw",
         "save"   : true,
         "comment": "Subnet mask (32bit)",
         "default": 4294967040
      },
      {
         "id"     : 235,
         "name"   : "ip_dest_address",
         "type"   : "u32",
         "access" : "rw",
         "save"   : true,
         "comment": "IP destination address (32bit)",
         "default": 3232238353
      },
      {
         "id"     : 236,
         "name"   : "ip_dest_port",
         "type"   : "u16",
         "access" : "rw",
         "save"   : true,
         "comment": "IP destination port",
         "default": 55555
      },
      {
         "id"     : 237,
         "name"   : "dynamics_source_switch",
         "type"   : "u8",
         "access" : "rw",
         "save"   : true,
         "min"    : 0,
         "max"    : 3,
         "comment": "0: Dynamics Data Source: dynSpdYawEst Port (ALGO), 1: Ethernet (dynamicsExt port), 2: Dynamics Data Source: pdrv Port (CAN) only speed and yawrate, 3: Speed (ALGO), Yaw Rate (extern CAN)",
         "default": 0
      },
      {
         "id"     : 238,
         "name"   : "mc_dest_address",
         "type"   : "u32",
         "min"    : 3758096384,
         "max"    : 4026531839,
         "access" : "rw",
         "save"   : true,
         "comment": "Multicast destination address for Alive (32bit)",
         "default": 4019191808
      },
      {
         "id"     : 239,
         "name"   : "mc_port",
         "type"   : "u16",
         "min"    : 1,
         "access" : "rw",
         "save"   : true,
         "comment": "Multicast destination port for Alive",
         "default": 60000
      }
   ]
}