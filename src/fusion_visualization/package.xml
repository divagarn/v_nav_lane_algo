<?xml version="1.0"?>
<package format="3">
  <name>fusion_visualization</name>
  <version>0.1.0</version>
  <description>RViz markers (class-sized 3D boxes in the radar frame, closest obstacles, range ring) and a camera overlay with projected radar points / fused tracks / 2D detections.</description>
  <maintainer email="n.divagar18@gmail.com">divagar</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>fusion_common</depend>
  <depend>libopencv-dev</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
