<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buggy_perception</name>
  <version>0.1.0</version>
  <description>Ground segmentation (torch RANSAC, CPU/GPU) + vehicle self-hit filtering, toggleable via the ground_filter launch argument in buggy_sensors/launch/sensors_bringup.launch.py. Also carries tf_odom_relay (sim TF plumbing) and the real-hardware equivalents: velodyne_static_tf, wheel_odometry, steering_uart_bridge.</description>
  <maintainer email="n.divagar18@gmail.com">divagar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>
  <depend>nav_msgs</depend>
  <depend>ground_segmentation_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
